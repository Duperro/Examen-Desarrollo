            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Paja Postman {{$guid}}\",\n  \"categoria\": \"PAJA\",\n  \"cantidad\": 10,\n  \"stockMinimo\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
