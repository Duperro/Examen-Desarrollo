{
  "info": {
    "name": "Escenario C · Gestión de recursos del pesebre",
    "description": "Casos del Parcial 1 de Desarrollo Basado en Plataformas para Rafael Alejandro Bermeo Macías. Ejecuta la colección en orden con la API y el Mercado SOAP configurados. Las claves se toman de las variables locales tokenEncargado y tokenPastor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenEncargado}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "tokenEncargado",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenPastor",
      "value": "",
      "type": "string"
    },
    {
      "key": "recursoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "stockAntesFault",
      "value": "",
      "type": "string"
    },
    {
      "key": "animalId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "    pm.test('El error usa el formato estándar de la API', function () {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.match(/^application\\/json\\b/i);",
          "        const error = pm.response.json();",
          "        pm.expect(error).to.have.all.keys('codigo', 'mensaje', 'detalles', 'timestamp', 'ruta');",
          "        pm.expect(error.codigo).to.be.a('string').and.not.be.empty;",
          "        pm.expect(error.mensaje).to.be.a('string').and.not.be.empty;",
          "        pm.expect(error.detalles).to.be.an('array');",
          "        pm.expect(new Date(error.timestamp).toISOString()).to.equal(error.timestamp);",
          "        pm.expect(error.ruta).to.equal(pm.variables.replaceIn(pm.request.url.getPath()));",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Inventario y seguridad",
      "item": [
        {
          "name": "201 · Registrar paja",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('recursoId', '');",
                  "pm.collectionVariables.set('stockAntesFault', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 · Guarda el ID del recurso creado\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const recurso = pm.response.json();",
                  "    pm.expect(Number.isSafeInteger(recurso.id) && recurso.id > 0).to.equal(true);",
                  "    pm.expect(recurso.categoria).to.equal('PAJA');",
                  "    pm.expect(recurso.cantidad).to.equal(10);",
                  "    pm.expect(recurso.estado).to.equal('DISPONIBLE');",
                  "    pm.expect(pm.response.headers.get('Location')).to.equal('/api/recursos/' + recurso.id);",
                  "    pm.collectionVariables.set('recursoId', String(recurso.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Paja Postman {{$guid}}\",\n  \"categoria\": \"PAJA\",\n  \"cantidad\": 10,\n  \"stockMinimo\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/recursos"
          }
        },
        {
          "name": "400 · Entrada inválida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 DATOS_INVALIDOS\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().codigo).to.equal('DATOS_INVALIDOS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"X\",\n  \"categoria\": \"INVALIDA\",\n  \"cantidad\": -1,\n  \"stockMinimo\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/recursos"
          }
        },
        {
