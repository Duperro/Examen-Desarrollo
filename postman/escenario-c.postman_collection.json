    },
    {
      "name": "Fault del Mercado de Belén",
      "item": [
        {
          "name": "200 · Consultar stock antes del Fault",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 · Guarda la cantidad previa al Fault\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const recurso = pm.response.json();",
                  "    pm.expect(recurso.id).to.equal(Number(pm.collectionVariables.get('recursoId')));",
                  "    pm.expect(recurso.cantidad).to.equal(10);",
                  "    pm.expect(recurso.estado).to.equal('DISPONIBLE');",
                  "    pm.collectionVariables.set('stockAntesFault', String(recurso.cantidad));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/recursos/{{recursoId}}"
          }
        },
        {
          "name": "202 · Provocar Fault con 999 unidades",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 · Reabastecimiento pendiente con el stock previo\", function () {",
                  "    pm.response.to.have.status(202);",
                  "    const recurso = pm.response.json();",
                  "    const stockAnterior = pm.collectionVariables.get('stockAntesFault');",
                  "    pm.expect(stockAnterior).to.match(/^\\d+$/);",
                  "    pm.expect(recurso.id).to.equal(Number(pm.collectionVariables.get('recursoId')));",
                  "    pm.expect(recurso.estado).to.equal('REABASTECIMIENTO_PENDIENTE');",
                  "    pm.expect(recurso.cantidad).to.equal(Number(stockAnterior));",
                  "    pm.expect(recurso.mensaje).to.match(/pendiente/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/recursos/{{recursoId}}/reabastecimiento",
            "description": "El valor 999 provoca el Fault del Mercado. Comprueba también el estado persistido en la siguiente petición."
          }
        },
        {
          "name": "200 · Verificar stock persistido después del Fault",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 · El inventario conserva la cantidad y el estado pendiente\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const recurso = pm.response.json();",
                  "    const stockAnterior = pm.collectionVariables.get('stockAntesFault');",
                  "    pm.expect(stockAnterior).to.match(/^\\d+$/);",
                  "    pm.expect(recurso.id).to.equal(Number(pm.collectionVariables.get('recursoId')));",
                  "    pm.expect(recurso.estado).to.equal('REABASTECIMIENTO_PENDIENTE');",
                  "    pm.expect(recurso.cantidad).to.equal(Number(stockAnterior));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/recursos/{{recursoId}}"
          }
        }
      ]
    },
