          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 TOKEN_REQUERIDO\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().codigo).to.equal('TOKEN_REQUERIDO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
