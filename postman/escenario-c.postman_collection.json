                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/recursos"
          }
        },
        {
          "name": "201 · Registrar animal",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('animalId', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 · Guarda el ID del animal\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const animal = pm.response.json();",
                  "    pm.expect(Number.isSafeInteger(animal.id) && animal.id > 0).to.equal(true);",
                  "    pm.expect(animal.especie).to.equal('BUEY');",
                  "    pm.expect(animal.racionDiaria).to.equal(3);",
                  "    pm.expect(animal.ultimaAlimentacion).to.equal(null);",
                  "    pm.collectionVariables.set('animalId', String(animal.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lucero Postman {{$guid}}\",\n  \"especie\": \"BUEY\",\n  \"racionDiaria\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/animales"
          }
        },
        {
          "name": "200 · Alimentar por primera vez",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 · La primera alimentación registra la fecha\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const animal = pm.response.json();",
                  "    pm.expect(animal.id).to.equal(Number(pm.collectionVariables.get('animalId')));",
                  "    pm.expect(animal.ultimaAlimentacion).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/animales/{{animalId}}/alimentacion"
          }
        },
        {
          "name": "422 · Alimentar dos veces el mismo día",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 ANIMAL_YA_ALIMENTADO\", function () {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().codigo).to.equal('ANIMAL_YA_ALIMENTADO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/animales/{{animalId}}/alimentacion"
